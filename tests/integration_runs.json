{
  "generators": [
    { "script": "tests/make_synthetic_package.py", "blender": true, "outputs": ["synthetic_multi.unitypackage"] },
    { "script": "tests/make_synthetic_scene_package.py", "blender": true, "outputs": ["synthetic_scene.unitypackage"] },
    { "script": "tests/make_synthetic_urp_package.py", "blender": true, "outputs": ["synthetic_urp.unitypackage", "synthetic_urp_standard.unitypackage"] },
    { "script": "tests/make_synthetic_hdrp_package.py", "blender": true, "outputs": ["synthetic_hdrp.unitypackage"] },
    { "script": "tests/make_synthetic_toon_package.py", "blender": true, "outputs": ["synthetic_toon.unitypackage"] },
    { "script": "tests/make_synthetic_terrain_package.py", "blender": true, "outputs": ["synthetic_terrain.unitypackage"] },
    { "script": "tests/make_synthetic_mesh_package.py", "blender": true, "outputs": ["synthetic_mesh.unitypackage"] },
    { "script": "tests/make_synthetic_anim_package.py", "blender": true, "outputs": ["synthetic_anim.unitypackage"] },
    { "script": "tests/make_synthetic_motion_package.py", "blender": true, "outputs": ["synthetic_motion.unitypackage"] },
    {
      "script": "tests/make_synthetic_nested_package.py",
      "blender": false,
      "args": ["{packages}"],
      "outputs": ["synthetic_nested.unitypackage"]
    },
    {
      "script": "tests/make_synthetic_broken_packages.py",
      "blender": false,
      "args": ["{packages}/synthetic_multi.unitypackage", "{packages}"],
      "outputs": ["synthetic_broken_model.unitypackage", "synthetic_broken_all.unitypackage"]
    }
  ],
  "runs": [
    { "package": "synthetic_multi.unitypackage", "expectations": "expectations_synthetic.json" },
    { "package": "synthetic_multi.unitypackage", "expectations": "expectations_synthetic_noblend.json", "note": "同梱 .blend 既定 OFF" },
    { "package": "synthetic_multi.unitypackage", "expectations": "expectations_synthetic_prefabs.json", "note": "読み込む単位 Prefabs（並べる）" },
    { "package": "synthetic_multi.unitypackage", "expectations": "expectations_synthetic_prefabs_stack.json", "note": "読み込む単位 Prefabs（原点に重ねる）" },
    { "package": "synthetic_scene.unitypackage", "expectations": "expectations_synthetic_scene.json", "note": "読み込む単位 Scenes" },
    { "package": "synthetic_scene.unitypackage", "expectations": "expectations_synthetic_scene_prefabs.json", "note": "読み込む単位 Prefabs（LODGroup の非表示）" },
    { "package": "synthetic_scene.unitypackage", "expectations": "expectations_synthetic_scene_keep_unused.json", "note": "Scenes で使われていない部品を読み込んで隠す" },
    { "package": "synthetic_scene.unitypackage", "expectations": "expectations_synthetic_scene_prefabs_keep_unused.json", "note": "Prefabs で使われていない部品を読み込んで隠す" },
    { "package": "synthetic_urp.unitypackage", "expectations": "expectations_synthetic_urp.json", "note": "URP Lit の読み方と URP のライト" },
    { "package": "synthetic_urp_standard.unitypackage", "expectations": "expectations_synthetic_urp_standard.json", "note": "ライトの追加データからの URP の判定" },
    { "package": "synthetic_hdrp.unitypackage", "expectations": "expectations_synthetic_hdrp.json", "note": "HDRP の読み方と HDRP のライト" },
    { "package": "synthetic_toon.unitypackage", "expectations": "expectations_synthetic_toon.json", "note": "Toon のノードグループ・アウトラインと、読み込んだ後の再構築・アウトライン・Backface Culling の操作" },
    { "package": "synthetic_toon.unitypackage", "expectations": "expectations_synthetic_toon_options.json", "note": "Principled・Force Opaque・法線と発光を使わない・Unity の情報を残さない・画像の取り込み・Legacy の FBX インポーター" },
    { "package": "synthetic_toon.unitypackage", "expectations": "expectations_synthetic_toon_reuse.json", "note": "同名のマテリアルの再利用と Unlit" },
    { "package": "synthetic_toon.unitypackage", "expectations": "expectations_synthetic_toon_names_only.json", "note": "Names Only と、そこからの再構築" },
    { "package": "synthetic_terrain.unitypackage", "expectations": "expectations_synthetic_terrain.json", "note": "Terrain の高さ・穴・塗り分け（新旧の TerrainData）" },
    { "package": "synthetic_terrain.unitypackage", "expectations": "expectations_synthetic_terrain_low_unlit.json", "note": "Terrain の間引き（129）と Unlit" },
    { "package": "synthetic_terrain.unitypackage", "expectations": "expectations_synthetic_terrain_none.json", "note": "Terrain を読み込まない設定（Terrain だけのシーンは読み込めない）" },
    { "package": "synthetic_mesh.unitypackage", "expectations": "expectations_synthetic_mesh.json", "note": "Unity の Mesh（.asset と prefab に埋め込んだもの）と .asset のマテリアルを使うシーン" },
    { "package": "synthetic_mesh.unitypackage", "expectations": "expectations_synthetic_mesh_prefabs.json", "note": "Unity の Mesh だけを使う prefab" },
    { "package": "synthetic_mesh.unitypackage", "expectations": "expectations_synthetic_mesh_models.json", "note": "FBX のマテリアルの画像が作者の PC のパスを指すモデル" },
    { "package": "synthetic_anim.unitypackage", "expectations": "expectations_synthetic_anim.json", "note": ".anim の Action（シェイプキー・表示の切り替え・Transform）と、読み込まないクリップの内訳" },
    { "package": "synthetic_anim.unitypackage", "expectations": "expectations_synthetic_anim_scene.json", "note": "シーンに 2 か所置いたモデルの両方にクリップを付ける" },
    { "package": "synthetic_anim.unitypackage", "expectations": "expectations_synthetic_anim_off.json", "note": "Animation を None にすると Action を作らない" },
    { "package": "synthetic_motion.unitypackage", "expectations": "expectations_synthetic_motion.json", "note": "モデルのテイクを .meta のクリップで分け、同じ骨格のモーションだけのアーマチュアをレストを変換してまとめる" },
    { "package": "synthetic_motion.unitypackage", "expectations": "expectations_synthetic_motion_active.json", "note": "Animation が Active なら、オブジェクトごとに最初のトラックだけミュートを外す" },
    { "package": "synthetic_motion.unitypackage", "expectations": "expectations_synthetic_motion_none.json", "note": "Animation が None ならテイクを読まず、アーマチュアもまとめない" },
    { "package": "synthetic_motion.unitypackage", "expectations": "expectations_synthetic_motion_scene.json", "note": "シーンに 2 か所置いたモデルで、テイクの Action を使い回す" },
    { "package": "synthetic_nested.unitypackage", "expectations": "expectations_synthetic_nested.json", "note": "入れ子のパッケージ（選ばなければ Built-in らしいもの）" },
    { "package": "synthetic_nested.unitypackage", "expectations": "expectations_synthetic_nested_chosen.json", "note": "入れ子のパッケージを選んで読む" },
    { "package": "synthetic_broken_model.unitypackage", "expectations": "expectations_synthetic_broken_model.json", "note": "1 つ失敗しても残りを読む" },
    { "package": "synthetic_broken_all.unitypackage", "expectations": "expectations_synthetic_broken_all.json", "note": "全部失敗したら何も残さない" }
  ]
}
